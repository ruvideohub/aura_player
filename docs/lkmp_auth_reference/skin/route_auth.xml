<#root>
  <syxme.lkmp.space.window.MultiSlideWindowView ^W="^M" ^H="^M" background="#131313" orientation="vertical">
    <ScrollView ^W="^M" ^H="^M" fillViewport="true" clipToPadding="false" app:binder="authScroll">
      <LinearLayout ^W="^M" ^H="^W" orientation="vertical" ^G="16" ^P="32dp">
        <LinearLayout app:binder="updateLayer" ^W="^M" ^H="100dp" orientation="vertical" visibility="gone" tools:visibility="visible">
          <TextView ^W="^M" ^H="^W" ^G="17" text="У вас старая версия" textAlignment="center" textColor="#FFFFFF" textSize="18sp" textStyle="bold">
          </TextView>
          <Button app:binder="update" style="@style/button_update" ^W="^M" ^H="^W" text="Обновить приложение" textColor="#fff">
          </Button>
        </LinearLayout>
        <LinearLayout app:binder="auth" ^W="^M" ^H="^W" ^LG="1" orientation="vertical">
          <syxme.lkmp.skinner.c.designGroup app:binder="logo" ^W="130dp" ^H="130dp" ^LG="1" app:image="img/logo">
          </syxme.lkmp.skinner.c.designGroup>
          <FrameLayout app:binder="content_block" ^W="^M" ^H="^W" ^MT="12dp">
            <#t></#t>
          </FrameLayout>
        </LinearLayout>
        <syxme.lkmp.skinner.c.designGroup app:binder="notLogin_btn" ^W="^M" ^H="56dp" app:background_color="#1E90FF" app:border="1px #6A605D5D" app:radius="8">
          <syxme.lkmp.skinner.c.designText ^W="^M" ^H="^M" ^G="17" ^PS="8dp" ^PE="8dp" maxLines="2" text="Музыка с телефона и радио" textColor="#B8B8B8" textColorHint="#a1a3a7" textSize="17sp" app:binder="button" app:text_colors="#FFFFFF">
          </syxme.lkmp.skinner.c.designText>
        </syxme.lkmp.skinner.c.designGroup>
        <syxme.lkmp.skinner.c.designGroup app:binder="another_confirm" ^W="^M" visibility="gone" ^H="48dp" ^MT="4dp" app:background_color="#1E90FF" app:border="1px #6A605D5D" app:radius="8">
          <syxme.lkmp.skinner.c.designText ^W="^M" ^H="^M" ^G="17" ^PS="8dp" ^PE="8dp" singleLine="true" text="Другой способ" textColor="#B8B8B8" textColorHint="#a1a3a7" textSize="20sp" app:binder="button" app:text_colors="#FFFFFF">
          </syxme.lkmp.skinner.c.designText>
        </syxme.lkmp.skinner.c.designGroup>
        <syxme.lkmp.skinner.c.designText ^W="^M" ^H="^W" ^G="17" text="Created by syxme" textColor="#FFFFFF" textSize="18sp" textStyle="bold" ^MT="28dp">
        </syxme.lkmp.skinner.c.designText>
      </LinearLayout>
    </ScrollView>
  </syxme.lkmp.space.window.MultiSlideWindowView>
</#root>
